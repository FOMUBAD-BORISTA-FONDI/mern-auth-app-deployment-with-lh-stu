# MongoDB Atlas connection string
# Get this from Atlas -> Database -> Connect -> Drivers
# Remember to replace <password> with your real DB user password
# and add the database name before the "?" (e.g. /mernauth?)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mernauth?retryWrites=true&w=majority

# Any long random string - used to sign JWT tokens
JWT_SECRET=replace_this_with_a_long_random_secret_string

# Port the API listens on (Render sets this automatically in production)
PORT=5000

# Comma-separated list of allowed frontend origins (CORS)
# Local dev example: http://localhost:5173
# After deploying, add your Vercel URL too, e.g:
# http://localhost:5173,https://your-app.vercel.app
CLIENT_URL=http://localhost:5173
